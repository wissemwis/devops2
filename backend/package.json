{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "test": "jest"
  },
  "dependencies": {
    "@strapi/database": "5.54.0",
    "@strapi/logger": "5.54.0",
    "@strapi/plugin-cloud": "5.54.0",
    "@strapi/plugin-users-permissions": "5.54.0",
    "@strapi/strapi": "5.54.0",
    "better-sqlite3": "12.8.0",
    "pg": "^8.16.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "fd32bc38-5620-4472-8d87-23b4c4f1b2fb",
    "installId": "6ddd3a2308c510fb5a20efc676e1541ba824c269ee2864d1091a443c50120a93"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "globalSetup": "<rootDir>/tests/helpers/global-setup.ts",
    "maxWorkers": 1,
    "testTimeout": 120000
  }
}
