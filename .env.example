# .env.example — project-wide environment variable reference
#
# This is the canonical, project-wide list of every environment variable
# `backend/` and `frontend/` need (local dev, CI, and the V1 production
# deployment on Vercel/Strapi Cloud — see specs/001-questionnaire-platform/
# research.md and plan.md § Constraints, Principe IV: aucun secret en clair
# dans le dépôt). Copy this file to `.env` (or configure the equivalent
# variables in the Vercel / Strapi Cloud dashboard per T053) and replace
# every placeholder value below with a real one — NEVER commit a real value.
#
# This file is distinct from backend/.env.example, which is the
# Strapi-scaffolded file used to bootstrap a local `backend/.env` (T002).
# The two variable sets overlap on purpose; this file is the project-wide
# reference that also covers frontend and SMTP concerns.

# ---------------------------------------------------------------------------
# Database (backend/config/database.ts)
# ---------------------------------------------------------------------------
# Which database client Strapi uses. "sqlite" for local dev, "postgres" for
# CI/production (per research.md's Storage decision).
DATABASE_CLIENT=sqlite

# Full Postgres connection string (production/CI). Takes precedence over the
# individual DATABASE_HOST/PORT/... fields below when set for the postgres client.
DATABASE_URL=postgres://changeme:changeme@your-db-host.example.com:5432/changeme

# Individual Postgres connection fields, used when DATABASE_URL is not set
# (or as documentation of what DATABASE_URL encodes).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=changeme
DATABASE_USERNAME=changeme
DATABASE_PASSWORD=changeme

# Enable TLS for the Postgres connection (production).
DATABASE_SSL=false

# SQLite database file path, relative to the backend/ project root (local dev only).
DATABASE_FILENAME=.tmp/data.db

# ---------------------------------------------------------------------------
# Logging (backend/config/logger.ts — Principe V, Observabilité)
# ---------------------------------------------------------------------------
# Minimum level of the structured JSON logs Strapi writes to stdout (one JSON
# object per line). Winston/npm levels: error, warn, info, http, verbose,
# debug, silly. Default "http" also keeps Strapi's per-request access logs.
LOG_LEVEL=http

# ---------------------------------------------------------------------------
# JWT / Strapi core secrets (backend/config/server.ts, admin.ts, and the
# users-permissions plugin) — every value here is a placeholder; generate
# real random secrets per environment, never reuse these or commit real ones.
# ---------------------------------------------------------------------------
# Comma-separated list of secret keys Strapi uses to sign session cookies.
APP_KEYS=tobemodified1,tobemodified2

# Secret used to sign admin panel JWTs.
ADMIN_JWT_SECRET=tobemodified

# Salt used when generating API tokens.
API_TOKEN_SALT=tobemodified

# Salt used when generating transfer tokens.
TRANSFER_TOKEN_SALT=tobemodified

# Secret used by the users-permissions plugin to sign end-user JWTs,
# including the signed invitation links for private questionnaires (FR-017).
JWT_SECRET=tobemodified

# Key used to encrypt sensitive data at rest (e.g. provider credentials).
ENCRYPTION_KEY=tobemodified

# ---------------------------------------------------------------------------
# SMTP (Strapi Email plugin / Nodemailer — per research.md's SMTP decision)
# Used to send the invitation emails required by FR-017. No
# backend/config/plugins.ts email block exists yet (a later task wires this
# up); these variables are documented here ahead of that so the deployment
# dashboards (T053) have a single source of truth.
# ---------------------------------------------------------------------------
# SMTP server hostname.
SMTP_HOST=your-smtp-host.example.com

# SMTP server port (587 for STARTTLS, 465 for implicit TLS).
SMTP_PORT=587

# SMTP auth username.
SMTP_USERNAME=changeme

# SMTP auth password.
SMTP_PASSWORD=changeme

# Default "From" address for outgoing invitation emails.
SMTP_DEFAULT_FROM=changeme@example.com

# Default "Reply-To" address for outgoing invitation emails.
SMTP_DEFAULT_REPLY_TO=changeme@example.com

# ---------------------------------------------------------------------------
# Frontend / cross-cutting (frontend/, per tasks.md T053 "API base URL")
# ---------------------------------------------------------------------------
# Base URL of the deployed Strapi backend that the Next.js frontend calls,
# per the REST contract in contracts/api.md. Must be set to the actual
# deployed backend URL (Strapi Cloud in V1) in every environment; NEXT_PUBLIC_
# variables are exposed to the browser, so this must never hold a secret.
NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com

DEV_AUTEUR_EMAIL=
DEV_AUTEUR_PASSWORD=
DEV_AUTEUR_NOM=
