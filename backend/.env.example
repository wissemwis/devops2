HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (backend/config/database.ts) — "sqlite" for local dev (default),
# "postgres" for CI/production, per research.md's Persistance decision. See
# the project-wide ../.env.example for the full documented variable set
# (DATABASE_URL, DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD, DATABASE_SSL,
# DATABASE_SCHEMA, DATABASE_POOL_MIN/MAX) used when DATABASE_CLIENT=postgres.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
